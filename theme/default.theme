view-background = "dark"
view-text = "content"
selection-background = "selection"
find-result-background = "darker-blue"
highlighted-find-result-background = "dark-blue"
inactive-line-number = "dimmed"
active-line-number = "alt"
gutter-guide = "dark-dimmed"
inactive-tab-background = "black"
active-tab-background = "mid"
inactive-tab-text = "alt"
active-tab-text = "blue"
inactive-tab-close = "alt"
active-tab-close = "alt"
scroll-bar-track = "dark-dimmed"
scroll-bar-color = "dimmed"
status-bar-background = "light"
status-bar-filename-text = "blue"
status-bar-position-text = "green"
status-bar-project-text = "orange"
command-palette-background = "mid"
command-palette-box-color = "dimmed"
command-palette-placeholder-text = "dimmed"
command-palette-input-background = "dark"
command-palette-input-text = "content"
command-palette-result-text = "content"
command-palette-result-context-text = "alt"
command-palette-selection-background = "blue"
command-palette-selection-text = "black"
project-search-location-text = "dimmed"
search-preview-background = "dark"

# The lines of a merge conflict, by side, from each marker to the next.
conflict-ours-background = "dark-green"
conflict-base-background = "dark-grey"
conflict-theirs-background = "dark-indigo"

# The active tab of whichever view doesn't have the keyboard focus.
unfocused-active-tab-background = "mid"
unfocused-active-tab-text = "alt"

# Terminals in the tool pane.
terminal-background = "tool"
terminal-text = "content"
terminal-link = "blue"
terminal-black = "light"
terminal-red = "red"
terminal-green = "green"
terminal-yellow = "orange"
terminal-blue = "blue"
terminal-magenta = "lavender"
terminal-cyan = "cyan"
terminal-white = "content"
terminal-bright-black = "dimmed"
terminal-bright-red = "#f0a8b0"
terminal-bright-green = "light-green"
terminal-bright-yellow = "yellow"
terminal-bright-blue = "#a0d8f4"
terminal-bright-magenta = "magenta"
terminal-bright-cyan = "light-cyan"
terminal-bright-white = "#ffffff"

# The selected row of a list on a page, with and without the keyboard.
# Text keeps its colors over both.
list-selection-background = "dark-blue"
unfocused-list-selection-background = "dark-highlight"

# The git log page: the labels beside commits, and the diff of a file.
git-head-text = "orange"
git-branch-text = "green"
git-remote-text = "red"
git-tag-text = "yellow"
git-hash-text = "blue"
git-author-text = "alt"
git-date-text = "alt"
diff-added-background = "dark-green"
diff-added-text = "green"
diff-removed-background = "dark-red"
diff-removed-text = "red"

# Syntax highlighting. A `*` prefix is bold, a `/` prefix is italic.
# Kinds left unset use their parent kind's style (see the theme docs).
syntax-comment = "alt"
syntax-doc-comment = "/alt"
syntax-keyword = "yellow"
syntax-control-keyword = "*yellow"
syntax-operator = "content"
syntax-punctuation = "alt"
syntax-number = "orange"
syntax-constant = "/orange"
syntax-string = "green"
syntax-string-escape = "*green"
syntax-regex = "/green"
syntax-type = "cyan"
syntax-primitive-type = "light-cyan"
syntax-type-definition = "*cyan"
syntax-function = "blue"
syntax-function-definition = "*blue"
syntax-macro = "red"
syntax-field = "lavender"
syntax-key = "lavender"
syntax-namespace = "light-cyan"
syntax-attribute = "alt"
syntax-lifetime = "/red"
syntax-label = "/red"
syntax-preprocessor = "magenta"
syntax-invalid = "*red"
syntax-heading = "*blue"
syntax-strong = "*content"
syntax-emphasis = "/content"
syntax-link = "light-cyan"
syntax-list-marker = "orange"
syntax-quote = "/alt"
syntax-variable = "lavender"
syntax-conflict-marker = "*red"

[names]
black = "#000000"
dark = "#1c1c1c"
mid = "#2a2a2a"
tool = "#202020"
light = "#404040"
highlight = "#4a4a4a"
selection = "#606060"
light-selection = "#808080"
inactive = "#808080"
content = "#e0e0e0"
alt = "#a0a0a0"
dimmed = "#707070"
dark-dimmed = "#404040"
dark-grey = "#353535"
dark-highlight = "#3c3c3c"
dark-green = "#2d3f30"
dark-indigo = "#2d3648"
dark-red = "#472b30"
green = "#a2d9af"
light-green = "#c3e6bd"
lavender = "#c4b5e6"
red = "#de8f97"
blue = "#80c6e9"
darker-blue = "#2a424d"
dark-blue = "#406374"
cyan = "#8ee6ed"
light-cyan = "#b0dde4"
orange = "#edbd81"
yellow = "#eddfb3"
magenta = "#dac4d1"
