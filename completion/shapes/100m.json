{
  "name": "100m",
  "description": "Target size for the repo-context experiments (syn-based signature header).",
  "model": {
    "d_model": 768,
    "n_layers": 12,
    "n_heads": 12,
    "d_ff": 2048,
    "rope_theta": 10000.0
  },
  "train": {
    "batch": 8,
    "tokens": 3000000000,
    "lr": 0.0004,
    "warmup": 1500,
    "weight_decay": 0.1,
    "eval_every": 500,
    "eval_batches": 32,
    "save_every": 1000
  }
}
